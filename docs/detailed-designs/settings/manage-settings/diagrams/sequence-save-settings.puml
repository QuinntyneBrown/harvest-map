@startuml
title UML sequence behaviour — Save settings
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Signed-in team member" as actor
box "Frontend — Harvest Map web app (React)" #E0F2FE
  participant "SettingsForm" as form
end box
box "Backend — Harvest Map web app (Next.js server)" #D1FADF
  participant "saveSettings server action" as action
end box
box "Backend — Harvest Map Application and Domain" #ECFDF3
  participant "SettingsService" as svc
  participant "FindingReverificationService" as rever
  participant "ResearchBannerService" as banner
end box
box "Backend — Harvest Map Infrastructure" #FFF4E5
  database "Harvest Map database" as db
end box
actor -> form : Change values, select "Save changes"
alt Invalid e-mail and non-domain Trusted sources line
  form --> actor : "Fix 2 things to save" with both messages and inline messages (L2-038 AC2)
else Input valid
  form -> form : Set busy on Save changes (L2-038 AC3)
  form -> action : saveSettings(SettingsInput)
  action -> action : Re-validate e-mail and domains
  action -> svc : save(userId, input)
  svc -> db : Update user, upsert user_preferences
  db --> svc : Commit result
  opt Admin changed Trusted sources
    svc -> rever : countAffected(trustedSources)
    rever -> db : Select affected findings
    db --> rever : Rows
    rever --> svc : Count
    svc -> banner : recordEvent(re-verification count) (L2-038 AC6)
  end
  alt Save succeeds
    svc --> action : Done
    action --> form : SaveSettingsResult ok
    form --> actor : "Saved · just now"; values persist across sessions and devices (L2-038 AC3)
  else Save fails
    action --> form : Failure
    form --> actor : Error alert, entries kept (L2-038 AC4)
  end
end
@enduml
