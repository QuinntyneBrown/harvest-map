@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Manage settings

Person(member, "Signed-in team member", "Manages profile and preferences")
System_Boundary(hm, "Harvest Map") {
  Container(web, "Harvest Map web app", "Next.js App Router, React", "Pages, server actions and route handlers")
  ContainerDb(db, "Harvest Map database", "PostgreSQL", "Users, preferences, findings and catalogue records")
}
Rel(member, web, "Uses", "HTTPS")
Rel(web, db, "Reads and writes users and preferences", "SQL")
@enduml
