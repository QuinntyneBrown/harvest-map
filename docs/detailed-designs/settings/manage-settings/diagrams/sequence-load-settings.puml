@startuml
title UML sequence behaviour — Load settings
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Signed-in team member" as actor
box "Frontend — Harvest Map web app (React)" #E0F2FE
  participant "SettingsPage" as page
  participant "SettingsForm" as form
end box
box "Backend — Harvest Map web app (Next.js server)" #D1FADF
  participant "loadSettings server action" as action
end box
box "Backend — Harvest Map Application and Domain" #ECFDF3
  participant "SettingsService" as svc
end box
box "Backend — Harvest Map Infrastructure" #FFF4E5
  database "Harvest Map database" as db
end box
actor -> page : Open /settings
page --> actor : Skeleton (L2-038 AC7)
page -> action : loadSettings()
action -> svc : load(userId from session)
svc -> db : Select user and user_preferences
alt Load succeeds
  db --> svc : Rows
  svc --> action : UserSettings
  action --> page : UserSettings
  page -> form : Render with values
  form --> actor : "Signed in as {e-mail}", Profile, Research, Appearance, Notifications, Save changes, Account (L2-038 AC1)
else Load fails
  action --> page : Failure
  page --> actor : "Couldn't load settings" with Try again and Go back (L2-038 AC7)
  opt Try again selected
    page -> action : loadSettings()
  end
end
@enduml
