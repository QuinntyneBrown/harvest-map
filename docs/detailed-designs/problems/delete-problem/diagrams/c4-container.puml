@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Delete a problem

Person(member, "Team member", "Confirms the delete")
System_Boundary(hm, "Harvest Map") {
  Container(web, "Harvest Map web app", "Next.js App Router, React", "Pages, server actions and route handlers")
  ContainerDb(db, "Harvest Map database", "PostgreSQL", "Problems and problem links")
}
Rel(member, web, "Uses", "HTTPS")
Rel(web, db, "Deletes problem and links, writes ranks", "SQL")
@enduml
