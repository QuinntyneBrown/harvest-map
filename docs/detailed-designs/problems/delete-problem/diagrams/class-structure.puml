@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Delete a problem

class DeleteProblemDialog {
  -busy: boolean
  +problemId: string
  +title: string
  +linkCount: number
  +confirm(): void
  +cancel(): void
}
class DeleteProblemResult {
  +ok: boolean
  +message: string
}
class ProblemService {
  +delete(id: string): void
  +recomputeRanking(): void
}
class Problem {
  +id: string
  +title: string
  +score: number
  +rank: number
}
class ProblemLink {
  +problemId: string
  +organizationId: string
}

DeleteProblemDialog ..> DeleteProblemResult : renders
ProblemService ..> Problem : deletes
ProblemService ..> ProblemLink : deletes
Problem "1" *-- "*" ProblemLink
@enduml
