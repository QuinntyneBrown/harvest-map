@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Create and edit a problem

Person(member, "Team member", "Fills in the problem form")
System_Boundary(hm, "Harvest Map") {
  Container(web, "Harvest Map web app", "Next.js App Router, React", "Pages, server actions and route handlers")
  ContainerDb(db, "Harvest Map database", "PostgreSQL", "Problems with scores and ranks")
}
Rel(member, web, "Uses", "HTTPS")
Rel(web, db, "Writes the problem, scores and ranks", "SQL")
@enduml
