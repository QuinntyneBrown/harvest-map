@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Link a problem to an organization

Person(member, "Team member", "Chooses what to link")
System_Boundary(hm, "Harvest Map") {
  Container(web, "Harvest Map web app", "Next.js App Router, React", "Pages, server actions and route handlers")
  ContainerDb(db, "Harvest Map database", "PostgreSQL", "Problems, organizations and problem links")
}
Rel(member, web, "Uses", "HTTPS")
Rel(web, db, "Reads options, inserts link, writes ranks", "SQL")
@enduml
