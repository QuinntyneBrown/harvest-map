@startuml
title UML sequence behaviour — Update the password
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Invited team member" as actor
box "Frontend — Harvest Map web app (React)" #E0F2FE
  participant "ResetPasswordForm" as form
  participant "ResetPasswordDone" as done
end box
box "Backend — Harvest Map web app (Next.js server)" #D1FADF
  participant "resetPassword server action" as action
end box
box "Backend — Harvest Map Application and Domain" #ECFDF3
  participant "PasswordResetService" as svc
end box
box "Backend — Harvest Map Infrastructure" #FFF4E5
  database "Harvest Map database" as db
end box
actor -> form : Enter New and Confirm password, select Update password
alt Shorter than 12 characters or mismatched
  form --> actor : "Fix 2 things to save" with "Use at least 12 characters" and/or "Passwords don't match" (L2-003 AC2)
else Passwords valid
  form -> form : Set busy on Update password
  form -> action : resetPassword(ResetPasswordInput)
  action -> action : Re-check 12-character minimum and match
  action -> svc : resetPassword(token, newPassword)
  svc -> db : Select reset token
  db --> svc : PasswordResetToken
  svc -> svc : Confirm token is valid, hash new password
  svc -> db : Update user passwordHash, mark token used, in one transaction
  db --> svc : Commit result
  svc --> action : Done
  action --> form : ResetPasswordResult ok
  form -> done : Render
  done --> actor : "Password updated" with "Sign in" link to /sign-in (L2-003 AC3)
end
@enduml
