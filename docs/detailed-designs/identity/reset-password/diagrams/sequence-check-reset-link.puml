@startuml
title UML sequence behaviour — Check the reset link
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Invited team member" as actor
box "Frontend — Harvest Map web app (React)" #E0F2FE
  participant "ResetPasswordPage" as page
  participant "ResetLinkError" as err
end box
box "Backend — Harvest Map web app (Next.js server)" #D1FADF
  participant "checkResetToken server action" as action
end box
box "Backend — Harvest Map Application and Domain" #ECFDF3
  participant "PasswordResetService" as svc
end box
box "Backend — Harvest Map Infrastructure" #FFF4E5
  database "Harvest Map database" as db
end box
actor -> page : Open reset link /reset-password
page --> actor : Show "Checking your link" (L2-003 AC1)
page -> action : checkResetToken(token)
action -> svc : checkToken(token)
svc -> db : Select reset token
db --> svc : PasswordResetToken or none
svc -> svc : Classify valid, expired, used or malformed
svc --> action : TokenCheckResult
action --> page : TokenCheckResult
alt Token valid
  page --> actor : Show "Choose a new password" form
else Token expired, used or malformed
  page -> err : Render
  err --> actor : "This link has expired", "Request a new link" to /forgot-password (L2-003 AC4)
end
@enduml
