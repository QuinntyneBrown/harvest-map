@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Reset password

enum TokenCheckResult {
  valid
  expired
  used
  malformed
}
class ResetPasswordForm {
  -busy: boolean
  +submit(input: ResetPasswordInput): void
}
class ResetPasswordInput {
  +token: string
  +newPassword: string
  +confirmPassword: string
}
class ResetPasswordResult {
  +ok: boolean
  +errors: FieldError[]
  +tokenState: TokenCheckResult
}
class FieldError {
  +field: string
  +message: string
}
class PasswordResetService {
  +checkToken(token: string): TokenCheckResult
  +resetPassword(token: string, newPassword: string): void
}
class User {
  +id: string
  +email: string
  +passwordHash: string
}
class PasswordResetToken {
  +id: string
  +userId: string
  +token: string
  +expiresAt: Date
  +usedAt: Date
}

ResetPasswordForm ..> ResetPasswordInput : builds
ResetPasswordForm ..> ResetPasswordResult : renders
ResetPasswordResult "1" *-- "*" FieldError
ResetPasswordResult --> TokenCheckResult
PasswordResetService ..> TokenCheckResult : returns
PasswordResetService ..> PasswordResetToken : reads / marks used
PasswordResetService ..> User : updates passwordHash
PasswordResetToken "*" --> "1" User
@enduml
