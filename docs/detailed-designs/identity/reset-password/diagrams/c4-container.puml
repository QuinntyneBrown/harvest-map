@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Reset password

Person(member, "Invited team member", "Chooses a new password")
System_Boundary(hm, "Harvest Map") {
  Container(web, "Harvest Map web app", "Next.js App Router, React", "Pages, server actions and route handlers")
  ContainerDb(db, "Harvest Map database", "PostgreSQL", "Users, reset tokens and catalogue records")
}
Rel(member, web, "Uses", "HTTPS")
Rel(web, db, "Reads reset tokens, updates password hashes", "SQL")
@enduml
