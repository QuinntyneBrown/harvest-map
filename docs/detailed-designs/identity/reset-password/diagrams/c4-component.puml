@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Reset password

Container_Boundary(web, "Harvest Map web app") {
  Component(page, "ResetPasswordPage", "React page, /reset-password", "Checks the link and picks the state to render")
  Component(form, "ResetPasswordForm", "React client component", "Validates passwords and submits once")
  Component(err, "ResetLinkError", "React client component", "Explains the link no longer works")
  Component(done, "ResetPasswordDone", "React client component", "Confirms the update and links to sign in")
  Component(check, "checkResetToken", "Next.js server action", "Classifies the reset token")
  Component(action, "resetPassword", "Next.js server action", "Sets the new password")
  Component(svc, "PasswordResetService", "TypeScript module", "Checks tokens and updates password hashes")
  ComponentDb(db, "Harvest Map database", "PostgreSQL", "users, password_reset_tokens")
}
Rel(page, check, "Calls on open")
Rel(page, form, "Renders when token is valid")
Rel(page, err, "Renders when token is not valid")
Rel(page, done, "Renders on success")
Rel(form, action, "Submits passwords to")
Rel(check, svc, "Calls")
Rel(action, svc, "Calls")
Rel(svc, db, "Reads token, updates user and token", "SQL")
@enduml
