@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Sign out

Person(member, "Signed-in team member", "Ends the session")
System_Boundary(hm, "Harvest Map") {
  Container(web, "Harvest Map web app", "Next.js App Router, React", "Pages, server actions and route handlers")
  ContainerDb(db, "Harvest Map database", "PostgreSQL", "Users, sessions and catalogue records")
}
Rel(member, web, "Uses", "HTTPS")
Rel(web, db, "Deletes sessions", "SQL")
@enduml
