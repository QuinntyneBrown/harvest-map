@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — View the Field home page

Person(member, "Signed-in team member", "Reads the Field home page")
System_Boundary(hm, "Harvest Map") {
  Container(web, "Harvest Map web app", "Next.js App Router, React", "Pages, server actions and route handlers")
  ContainerDb(db, "Harvest Map database", "PostgreSQL", "Organizations, people, problems, findings and research runs")
}
Rel(member, web, "Uses", "HTTPS")
Rel(web, db, "Reads counts, answers, ranked problems and runs", "SQL")
@enduml
