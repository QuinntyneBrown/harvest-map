@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Monitor research runs

Person(member, "Team member", "Follows and stops runs")
System_Boundary(hm, "Harvest Map") {
  Container(web, "Harvest Map web app", "Next.js App Router, React", "Pages, server actions and route handlers")
  Container(executor, "Research run executor", "<TO SUPPLY>", "Executes research runs in the background")
  ContainerDb(db, "Harvest Map database", "PostgreSQL", "Runs, run events, findings and notifications")
}
System_Ext(search, "Web search provider", "<TO SUPPLY>")
System_Ext(ai, "AI provider", "<TO SUPPLY>")
Rel(member, web, "Uses", "HTTPS")
Rel(web, db, "Reads runs, events and findings, writes stop request", "SQL")
Rel(executor, db, "Writes events, findings, progress and status", "SQL")
Rel(executor, search, "Searches", "<TO SUPPLY>")
Rel(executor, ai, "Extracts findings", "<TO SUPPLY>")
@enduml
