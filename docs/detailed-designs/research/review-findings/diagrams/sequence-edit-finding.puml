@startuml
title UML sequence behaviour — Edit and accept a finding
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Team member" as actor
box "Frontend — Harvest Map web app (React)" #E0F2FE
  participant "FindingCard" as card
  participant "ReviewFindingDialog" as dialog
end box
box "Backend — Harvest Map web app (Next.js server)" #D1FADF
  participant "acceptFinding server action" as action
end box
box "Backend — Harvest Map Application and Domain" #ECFDF3
  participant "FindingService" as service
end box
box "Backend — Harvest Map Infrastructure" #FFF4E5
  database "Harvest Map database" as db
end box
actor -> card : Select Edit
card -> dialog : Open with the finding
dialog --> actor : "Updates {subject} · {organization}", statement, "Confidence {p}% · {n} sources", status, fields, Sources, Reject, Cancel, Accept (L2-024 AC5)
opt Content exceeds the viewport height
  dialog --> actor : Body scrolls; header and footer stay fixed (L2-024 AC7)
end
actor -> dialog : Adjust fields, select Accept
alt Required field empty
  dialog --> actor : "Fix 1 thing to save" lists the problem, for example "Enter a role" (L2-024 AC6)
else Fields valid
  dialog -> dialog : Set busy, disable inputs and actions
  dialog -> action : acceptFinding(id, FindingChange)
  action -> service : accept(id, change, userId)
  service -> db : Create or update subject record, set state Accepted, insert activity entry (L2-024 AC8)
  alt Request fails
    db --> service : Error
    service --> action : Error
    action --> dialog : FindingDecisionResult with error
    dialog --> actor : "Couldn't save — Your edits are kept. Try again.", Accept available to retry (L2-024 AC7)
  else Request succeeds
    db --> service : Commit result
    service --> action : FindingDecisionResult
    action --> dialog : Result ok
    dialog --> card : Close, focus returns to Edit
    card --> actor : "Accepted by {person} · Undo available for 30 s" with Undo (L2-024 AC2)
  end
end
@enduml
