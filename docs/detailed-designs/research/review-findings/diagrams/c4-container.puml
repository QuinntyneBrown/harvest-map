@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Review findings

Person(member, "Team member", "Decides on findings")
System_Boundary(hm, "Harvest Map") {
  Container(web, "Harvest Map web app", "Next.js App Router, React", "Pages, server actions and route handlers")
  ContainerDb(db, "Harvest Map database", "PostgreSQL", "Findings, sources, organizations, people and activity")
}
Rel(member, web, "Uses", "HTTPS")
Rel(web, db, "Updates findings and records, writes activity", "SQL")
@enduml
