@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Delete person

Container_Boundary(web, "Harvest Map web app") {
  Component(page, "PersonPage", "React server component, /people/[id]", "Renders the Delete action")
  Component(dialog, "DeletePersonDialog", "React client component", "Confirms, shows busy and failed states")
  Component(action, "deletePerson", "Next.js server action", "Deletes and redirects to /people")
  Component(service, "PersonService", "TypeScript module", "People application logic")
  Component(repo, "PersonRepository", "TypeScript module", "Data access for people")
  ComponentDb(db, "Harvest Map database", "PostgreSQL", "people, sources")
}
Rel(page, dialog, "Opens from Delete")
Rel(dialog, action, "Submits person id to")
Rel(action, service, "Calls delete")
Rel(service, repo, "Deletes through")
Rel(repo, db, "Deletes person and sources in one transaction", "SQL")
@enduml
