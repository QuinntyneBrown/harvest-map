@startuml
title UML sequence behaviour — Add person to organization
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Team member" as actor
box "Frontend — Harvest Map web app (React)" #E0F2FE
  participant "OrganizationPeopleSection" as section
  participant "AddPersonDialog" as dialog
end box
box "Backend — Harvest Map web app (Next.js server)" #D1FADF
  participant "addPerson server action" as action
end box
box "Backend — Harvest Map Application and Domain" #ECFDF3
  participant "PersonService" as service
end box
box "Backend — Harvest Map Infrastructure" #FFF4E5
  participant "PersonRepository" as repo
  database "Harvest Map database" as db
end box
actor -> section : Select Add
section -> dialog : Open for organization
dialog --> actor : "Add person to {organization}" with Name, Role, LinkedIn (L2-011 AC1)
actor -> dialog : Enter values, select Add person
alt Name empty
  dialog --> actor : Summary "Fix 1 thing to save" lists "Enter a name", focus summary (L2-011 AC2)
else Name filled
  dialog -> dialog : Set busy, disable Cancel (L2-011 AC3)
  dialog -> action : addPerson(AddPersonInput)
  action -> service : addToOrganization(input)
  service -> repo : insert(Person)
  repo -> db : Insert people row with organization_id
  alt Insert succeeds
    db --> repo : Stored row
    repo --> service : Person
    service --> action : Person
    action -> action : Revalidate organization page path
    action --> dialog : AddPersonResult ok
    dialog --> actor : Success "{name} added" with Done and Add another (L2-011 AC3)
    section --> actor : Person listed in People section (L2-011 AC3)
  else Request fails
    action --> dialog : Failure
    dialog --> actor : "Couldn't add the person", entries kept, Add person retries (L2-011 AC4)
  end
end
@enduml
