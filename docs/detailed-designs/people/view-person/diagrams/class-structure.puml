@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — View person

class PersonPage {
  +id: string
  +render(detail: PersonDetail): void
}
class PersonService {
  +getPersonDetail(id: string): PersonDetail | null
}
class PersonRepository {
  +findDetailById(id: string): PersonDetail | null
}
class PersonDetail {
  +person: Person
  +organizationName: string
  +organizations: OrganizationCard[]
  +sources: SourceItem[]
  +verifiedSourceCount: number
  +activity: ActivityEntry[]
  +onlyUnverifiedFinding: boolean
}
class Person {
  +id: string
  +name: string
  +role: string
  +organizationId: string
  +linkedinUrl: string | null
  +bio: string | null
  +since: string | null
}
class OrganizationCard {
  +id: string
  +name: string
  +type: string
  +city: string
  +reach: string
  +tags: string[]
}
class SourceItem {
  +title: string
  +url: string
  +domain: string
  +status: string
  +date: Date
}
class ActivityEntry {
  +date: Date
  +text: string
}

PersonPage ..> PersonService : calls
PersonService ..> PersonRepository : uses
PersonRepository ..> PersonDetail : returns
PersonDetail *-- "1" Person
PersonDetail "1" *-- "*" OrganizationCard
PersonDetail "1" *-- "*" SourceItem
PersonDetail "1" *-- "*" ActivityEntry
@enduml
