@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Explore the map

Person(member, "Signed-in team member", "Explores the map")
System_Boundary(hm, "Harvest Map") {
  Container(web, "Harvest Map web app", "Next.js App Router, React", "Pages, server actions and route handlers")
  ContainerDb(db, "Harvest Map database", "PostgreSQL", "Organizations and catalogue records")
}
Rel(member, web, "Uses", "HTTPS")
Rel(web, db, "Reads organizations with city and tags", "SQL")
@enduml
