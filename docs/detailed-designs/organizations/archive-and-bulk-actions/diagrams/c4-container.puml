@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Archive and bulk actions

Person(member, "Team member", "Archives and tags organizations")
Person(team, "Other team members", "Read notifications")
System_Boundary(hm, "Harvest Map") {
  Container(web, "Harvest Map web app", "Next.js App Router, React", "Pages, server actions and route handlers")
  ContainerDb(db, "Harvest Map database", "PostgreSQL", "Users, sessions, catalogue records and notifications")
}
Rel(member, web, "Uses", "HTTPS")
Rel(team, web, "Reads notifications in", "HTTPS")
Rel(web, db, "Updates organizations, inserts notifications", "SQL")
@enduml
