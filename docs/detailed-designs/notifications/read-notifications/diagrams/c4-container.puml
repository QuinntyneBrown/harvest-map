@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Read notifications

Person(member, "Invited team member", "Reads and marks notifications")
System_Boundary(hm, "Harvest Map") {
  Container(web, "Harvest Map web app", "Next.js App Router, React", "Pages, server actions and route handlers")
  ContainerDb(db, "Harvest Map database", "PostgreSQL", "Notifications, user preferences and catalogue records")
}
Rel(member, web, "Uses", "HTTPS")
Rel(web, db, "Reads and updates notifications, reads preferences", "SQL")
@enduml
