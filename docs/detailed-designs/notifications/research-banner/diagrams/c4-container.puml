@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Research banner

Person(member, "Invited team member", "Reads and dismisses banners")
System_Boundary(hm, "Harvest Map") {
  Container(web, "Harvest Map web app", "Next.js App Router, React", "Pages, server actions and route handlers")
  ContainerDb(db, "Harvest Map database", "PostgreSQL", "Research runs, banner events and dismissals")
}
Rel(member, web, "Uses", "HTTPS")
Rel(web, db, "Reads runs and banner events, writes dismissals", "SQL")
@enduml
