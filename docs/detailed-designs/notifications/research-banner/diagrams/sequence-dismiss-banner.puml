@startuml
title UML sequence behaviour — Dismiss the research banner
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Invited team member" as actor
box "Frontend — Harvest Map web app (React)" #E0F2FE
  participant "ResearchBanner" as banner
end box
box "Backend — Harvest Map web app (Next.js server)" #D1FADF
  participant "dismissResearchBanner server action" as action
end box
box "Backend — Harvest Map Application and Domain" #ECFDF3
  participant "ResearchBannerService" as svc
end box
box "Backend — Harvest Map Infrastructure" #FFF4E5
  database "Harvest Map database" as db
end box
actor -> banner : Select Dismiss
banner -> banner : Hide banner
banner -> action : dismissResearchBanner(eventId)
action -> svc : dismiss(userId, eventId)
svc -> db : Insert banner_dismissals row
db --> svc : Inserted
svc --> action : Done
action --> banner : Ok
actor -> banner : Navigate or reload later
banner -> svc : current(userId) via route handler
svc --> banner : Dismissed event excluded
banner --> actor : Banner does not return for that event (L2-035 AC3)
@enduml
