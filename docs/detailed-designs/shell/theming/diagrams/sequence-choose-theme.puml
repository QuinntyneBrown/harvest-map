@startuml
title UML sequence behaviour — Choose a theme
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Invited team member" as actor
box "Frontend — Harvest Map web app (React)" #E0F2FE
  participant "Theme control" as control
  participant "ThemeController" as ctrl
end box
box "Backend — Harvest Map web app (Next.js server)" #D1FADF
  participant "saveThemePreference server action" as action
end box
box "Backend — Harvest Map Application and Domain" #ECFDF3
  participant "PreferencesService" as prefs
end box
box "Backend — Harvest Map Infrastructure" #FFF4E5
  database "Harvest Map database" as db
end box
actor -> control : Pick Light, Dark or Match system
control -> ctrl : apply(preference)
alt Light or Dark
  ctrl -> ctrl : Set html data-theme, overriding the OS (L2-042 AC2)
else Match system
  ctrl -> ctrl : Remove html data-theme
end
ctrl --> actor : Theme applies at once
ctrl -> action : saveThemePreference(preference)
action -> prefs : updateTheme(userId, preference)
prefs -> db : Update user_preferences.theme
db --> prefs : Saved
prefs --> action : Done
action --> ctrl : Ok
note over actor, db : Later sessions render the stored preference from RootLayout (L2-042 AC2)
@enduml
